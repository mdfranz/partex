# Python build/test byproducts inside tracked trees.
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.coverage.*

# Keep root-level editor/OS junk out even though root files are tracked.
.DS_Store
*.swp
*~

# Local engagement/probe databases (SQLite + WAL sidecars) and per-machine MCP config.
/*.db
/*.db-shm
/*.db-wal
/*.db-journal
.mcp.json
.env
.env.*
*.log

# Tool caches and build output (top-level dirs are no longer allowlisted).
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.claude/settings.local.json
build/
dist/
node_modules/
.venv*/
.tox/
.nox/
htmlcov/
.worktrees/
.idea/
.vscode/

# Local reference clones (pydantic-ai, CLAI2, ...) and sibling worktrees.
/pydantic-ai/
/pydantic-ai-*/
/clai2/
/pydantic-clai2/
/pydantic-monty*/

# Downloaded target assets and operator exports (may hold secrets), beside the local DB.
*.db.artifacts/
*.db.exports/
