# Allowlist: track root files plus partex's own source, test, and data trees. Every other
# top-level directory (venvs, build output, reference clones) stays untracked.
/*/
!src/
!tests/
!skills/
!fixtures/
!scripts/
!bench/
!.github/

# Python build/test byproducts inside tracked trees.
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.coverage.*

# Keep root-level editor/OS junk out even though root files are tracked.
.DS_Store
*.swp
*~
